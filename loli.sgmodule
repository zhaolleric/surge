#!name=LOLI Labs 自动签到
#!desc=自动获取 Token，每日自动签到
#!author=Eric
#!icon=https://loli.host/favicon.ico

#!arguments CronExp="5 0 * * *"

[Script]

# 自动捕获 LOLI Token
LOLI Token = type=http-request,pattern=^https://labs-api\.loli\.host/api/v1/,script-path=https://raw.githubusercontent.com/zhaolleric/surge/refs/heads/main/loli.js,timeout=10

# LOLI 自动签到
LOLI 自动签到 = type=cron,cronexp="{{{CronExp}}}",wake-system=true,script-path=https://raw.githubusercontent.com/zhaolleric/surge/refs/heads/main/loli.js,timeout=30

[MITM]
hostname = %APPEND% labs-api.loli.host
