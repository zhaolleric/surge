#!name=Loli Labs 自动签到
#!desc=打开 loli.host 时捕获 Token，每日自动签到
#!author=Eric
#!homepage=https://loli.host
#!icon=https://loli.host/favicon.ico

#!argument=CronExp=5 0 * * *

[Script]
Loli Labs = type=cron,cronexp="{{{CronExp}}}",script-path=https://raw.githubusercontent.com/zhaolleric/surge/refs/heads/main/loli.js
Loli Labs Token = type=http-request,pattern=^https:\/\/labs-api\.loli\.host\/api\/v1\/mails\/unread-count$,script-path=https://raw.githubusercontent.com/zhaolleric/surge/refs/heads/main/loli.js
