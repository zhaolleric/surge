#!name=LOLI Labs 自动签到
#!desc=自动捕获 LOLI Token + 每日签到
#!author=Eric
#!date=2026-09-26
#!arguments=CronExp:30 7 * * *
#!arguments-desc=CronExp:签到时间 (Cron 表达式)

[Script]
LOLI Labs Token=type=http-request,pattern=^https://labs-api\.loli\.host/,requires-body=0,script-path=https://raw.githubusercontent.com/zhaolleric/surge/refs/heads/main/loli.js

LOLI Labs 签到=type=cron,cronexp="{{{CronExp}}}",wake-system=1,timeout=60,script-path=https://raw.githubusercontent.com/zhaolleric/surge/refs/heads/main/loli.js
